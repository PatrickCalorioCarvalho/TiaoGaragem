{
  "expo": {
    "name": "TiaoGaragem",
    "slug": "TiaoGaragem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tiaogaragem",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tiaogaragem.app"
    },
    "android": {
      "package": "com.tiaogaragem.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TiaoGaragem usa suas fotos para registrar o estado do pneu, água e óleo no checklist semanal.",
          "cameraPermission": "O TiaoGaragem usa a câmera para fotografar o pneu, água e óleo no checklist semanal."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextMaintenance",
              "label": "Próxima manutenção",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Mostra o veículo com a manutenção mais urgente",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "extra": {
      "googleAndroidClientId": "55277323397-iujqaf06o7rc238rhhivbjaolckd6qlf.apps.googleusercontent.com",
      "googleIosClientId": ""
    }
  }
}
